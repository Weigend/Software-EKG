<?xml version="1.0" encoding="UTF-8"?>

<?import io.softwareecg.awb.importer.ui.controls.fileselector.LabeledFileSelector?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<fx:root type="LabeledFileSelector"
         xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx"
         fx:controller="io.softwareecg.awb.importer.ui.controls.fileselector.LabeledFileSelectorController" >

    <columnConstraints>
        <ColumnConstraints minWidth="245" maxWidth="245" hgrow="NEVER" halignment="LEFT" />
        <ColumnConstraints hgrow="ALWAYS"/>
        <ColumnConstraints hgrow="NEVER"/>
    </columnConstraints>

    <rowConstraints>
        <RowConstraints minHeight="34.0" prefHeight="34.0" vgrow="NEVER"/>
    </rowConstraints>

    <!--
    Label on the left site with variable text, set from outside
    -->
    <Label fx:id="lblFileSelectorLabel" styleClass="dialogLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />


    <!-- Start: Chooser for the directory or single files -->

    <TextField fx:id="txtFilePath" GridPane.columnIndex="1" GridPane.rowIndex="0" prefHeight="32"/>

    <SplitMenuButton fx:id="btnBrowse" GridPane.rowIndex="0" GridPane.columnIndex="2"
                     mnemonicParsing="false" text="Browse..." prefHeight="32" >
        <items>
            <MenuItem fx:id="btnBrowsePath" mnemonicParsing="false" text="Browse Dir..." />
        </items>
        <items>
            <MenuItem fx:id="btnBrowseFiles" mnemonicParsing="false" text="Browse Files..." />
        </items>
    </SplitMenuButton>

    <!-- END: Chooser  -->

    <stylesheets>
        <URL value="@LabeledFileSelectorStyle.css"/>
    </stylesheets>

</fx:root>
