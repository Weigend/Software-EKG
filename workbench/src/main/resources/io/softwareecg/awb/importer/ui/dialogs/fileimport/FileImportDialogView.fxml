<?xml version="1.0" encoding="UTF-8"?>

<?import io.softwareecg.awb.importer.ui.dialogs.fileimport.FileImportDialog?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import io.softwareecg.awb.importer.ui.controls.fileselector.LabeledFileSelector?>
<fx:root type="FileImportDialog" prefHeight="540.0" prefWidth="740.0"
         xmlns="http://javafx.com/javafx" id="outerBorderPane" fx:id="importDialog" xmlns:fx="http://javafx.com/fxml" >

    <top>
        <VBox id="header">
            <!-- header -->
            <Label fx:id="headerLabel" />
        </VBox>
    </top>


    <center>
        <AnchorPane id="CenterContentPane" >

            <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" spacing="10">

                <!--
                ==============================================================================================
                   target selection
                ==============================================================================================
                -->
                <Label styleClass="lblHeadlines"  text="Select Repository and Target Project:" VBox.vgrow="ALWAYS" />

                <BorderPane fx:id="bpRepositorySelector" minHeight="34"/>

                <Separator />

                <BorderPane fx:id="bpProjectSelector"/>

                <!--
                ==============================================================================================
                  source selection
                ==============================================================================================
                -->
                <Label styleClass="lblHeadlines" text="Select Files for Import:" VBox.vgrow="ALWAYS" />

                <LabeledFileSelector fx:id="defaultFileSelector" labelText="Selected Files:" />

                <!-- empty wrapper for childs that can added by deriving dialogs -->
                <VBox fx:id="vbExtendedChilds" spacing="10" maxWidth="Infinity">


                </VBox>

                <Separator />
            </VBox>
        </AnchorPane>
    </center>

    <!-- bottom bar with close or submit action -->
    <bottom>
        <HBox id="footer" alignment="CENTER_RIGHT" spacing="10.0" >
            <Button id="ok" fx:id="btnOK" text="Import Data"/>
            <Button id="cancel" fx:id="btnCancel" text="Cancel"/>
        </HBox>
    </bottom>


    <stylesheets>
        <URL value="@FileImportDialogStyle.css"/>
    </stylesheets>


</fx:root>
