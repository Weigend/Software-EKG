<?xml version="1.0" encoding="UTF-8"?>

<?scenebuilder-stylesheet splash.css?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import java.net.URL?>
<Pane maxHeight="460.0" maxWidth="690.0" minHeight="460.0" minWidth="690.0" prefHeight="460.0" prefWidth="690.0"
      styleClass="splash" xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.softwareecg.wfx.platform.core.ProgressController">

    <stylesheets>
        <URL value="@splash.css"/>
    </stylesheets>

    <ImageView fitHeight="460.0" fitWidth="690.0" smooth="true">
        <Image url="@software-ekg-splash-visual-blue-amber.png"/>
    </ImageView>

    <TextFlow layoutX="40.0" layoutY="40.0">
        <Text styleClass="splash-title" text="Software-EKG "/>
        <Text styleClass="splash-title,splash-version" text="7.X"/>
    </TextFlow>
    <Label layoutX="43.0" layoutY="104.0" styleClass="splash-subtitle" text="AI-powered analysis &amp; reasoning"/>

    <Label fx:id="progressText" layoutX="40.0" layoutY="382.0" prefWidth="420.0"
           styleClass="splash-progress-text" text="Loading..."/>

    <ProgressBar fx:id="progressBar" layoutX="44.0" layoutY="412.0" prefWidth="320.0" prefHeight="6"
                 progress="0.01" styleClass="splash-progress-bar"/>

    <TextFlow layoutX="560.0" layoutY="404.0">
        <Text styleClass="splash-brand,splash-initial" text="W"/>
        <Text styleClass="splash-brand" text="eigend"/>
        <Text styleClass="splash-brand,splash-accent" text="."/>
    </TextFlow>

</Pane>
