#!/bin/bash

### BEGIN INIT INFO
# Provides:          ekg-collector
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Software-EKG collector
# Description:       Runs the Software-EKG collector in the background.
### END INIT INFO

#
# Runs the Software-EKG collector in the background:
#
#   ekg-collector start | stop | restart | status | version
#
# The script can be called where it lies or through a link, for example from /etc/init.d.
#
# Environment (for a service: set them in /etc/default/ekg-collector, which is read if it exists):
#   EKG_COLLECTOR_CONFIG      the configuration (default: config/default/config.yaml)
#   EKG_COLLECTOR_LOGDIR      where the collector writes (default: logs)
#   EKG_COLLECTOR_JAVA_OPTS   options for the JVM (default: -Xmx386m). To have the collector
#                             measured itself over Jolokia, add
#                             -javaagent:lib/jolokia-jvm-1.6.0-agent.jar=port=8778,host=localhost
#   EKG_COLLECTOR_UI          set to 1 to show on a screen of this machine what the collector is
#                             doing. A service has no screen of its own: it needs DISPLAY (and
#                             the right to use that screen) in its environment as well.
#   JAVA_HOME                 the Java 25 runtime, unless the distribution brings one in "jre"
#   and whatever the configuration refers to with ${ENV:NAME} - passwords, for example.

if [ -r /etc/default/ekg-collector ]; then
    set -a
    . /etc/default/ekg-collector
    set +a
fi

# $0 may be a link
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

CONFIG="${EKG_COLLECTOR_CONFIG:-$HERE/config/default/config.yaml}"
LOGDIR="${EKG_COLLECTOR_LOGDIR:-$HERE/logs}"
JAVA_OPTS="${EKG_COLLECTOR_JAVA_OPTS:--Xmx386m}"
PID_FILE="$HERE/ekg-collector.pid"
# what the JVM itself prints; everything else goes to the log files of the collector
STDERR="$HERE/stderr.log"

# What the JVM would warn about although it is intended: native code is loaded by the
# JavaScript engine of the calculated metrics and by the Windows counters, and that engine
# uses sun.misc.Unsafe and runs without a compiler of its own.
QUIET="--enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -Dpolyglot.engine.WarnInterpreterOnly=false"

if [ "${EKG_COLLECTOR_UI:-}" = "1" ]; then
    JAVA_OPTS="$JAVA_OPTS -Dcollector.ui=true"
fi

MIN_JAVA=25
JAVA=""
REJECTED=""

# Takes the Java given if it starts and is new enough, and notes why not otherwise.
try_java() {
    local java="$1" origin="$2" version
    if [ -n "$JAVA" ] || [ ! -x "$java" ]; then
        return 0
    fi
    version="$("$java" -XshowSettings:properties -version 2>&1 | sed -n 's/^ *java\.specification\.version = //p' | head -n 1)"
    version="${version#1.}"
    version="${version%%.*}"
    case "$version" in
        '' | *[!0-9]*)
            REJECTED="$REJECTED\n  $java ($origin): does not start on this machine ($(uname -s) $(uname -m))"
            ;;
        *)
            if [ "$version" -lt "$MIN_JAVA" ]; then
                REJECTED="$REJECTED\n  $java ($origin): is Java $version"
            else
                JAVA="$java"
            fi
            ;;
    esac
}

# the runtime of the distribution, then JAVA_HOME, then the PATH; one that does not start on
# this machine or is older than Java 25 is skipped
find_java() {
    try_java "$HERE/jre/bin/java" "the runtime of this distribution"
    if [ -n "$JAVA_HOME" ]; then
        if [ -x "$JAVA_HOME/bin/java" ]; then
            try_java "$JAVA_HOME/bin/java" "JAVA_HOME"
        else
            REJECTED="$REJECTED\n  JAVA_HOME=$JAVA_HOME: there is no bin/java in it"
        fi
    fi
    if command -v java > /dev/null 2>&1; then
        try_java "$(command -v java)" "PATH"
    fi
    if [ -z "$JAVA" ]; then
        if [ -z "$REJECTED" ]; then
            REJECTED="\n  none: no \"jre\" directory in $HERE, JAVA_HOME is not set, no java in the PATH"
        fi
        printf '%b\n' "The collector needs Java $MIN_JAVA or newer. Found:$REJECTED\n\nInstall a JDK $MIN_JAVA and set JAVA_HOME, for a service in /etc/default/ekg-collector." >&2
        return 1
    fi
}

# prints the pid of the collector if it runs
running_pid() {
    if [ -s "$PID_FILE" ]; then
        local pid
        pid="$(cat "$PID_FILE")"
        if kill -0 "$pid" 2> /dev/null; then
            echo "$pid"
            return 0
        fi
    fi
    return 1
}

start() {
    local pid
    if pid="$(running_pid)"; then
        echo "The collector is running already (pid $pid)."
        return 1
    fi
    find_java || return 1
    if [ ! -f "$CONFIG" ]; then
        echo "There is no configuration $CONFIG." >&2
        return 1
    fi
    if ! mkdir -p "$LOGDIR" 2> /dev/null || [ ! -w "$LOGDIR" ]; then
        echo "The log directory $LOGDIR cannot be written. Set EKG_COLLECTOR_LOGDIR to another one." >&2
        return 1
    fi
    # The display of the collector needs JavaFX, which wants to be loaded as modules: from the
    # runtime if it has it, from lib/javafx otherwise. Not every runtime takes the modules of
    # lib/javafx, so they are tried first: collecting must not depend on it.
    FX=()
    if ls "$HERE"/lib/javafx/javafx-*.jar > /dev/null 2>&1; then
        FX=(--module-path "$HERE/lib/javafx" --add-modules javafx.controls --enable-native-access=javafx.graphics)
        if ! "$JAVA" "${FX[@]}" -version > /dev/null 2>&1; then
            FX=()
        fi
    fi
    if ! touch "$PID_FILE" "$STDERR" 2> /dev/null; then
        echo "$HERE cannot be written; the collector keeps its pid and the output of the JVM there." >&2
        return 1
    fi
    # relative paths of the configuration and of the repository are meant from here
    cd "$HERE" || return 1
    # shellcheck disable=SC2086
    nohup "$JAVA" $JAVA_OPTS $QUIET ${FX[@]+"${FX[@]}"} \
        -Dlogback.configurationFile="$HERE/config/logback.xml" \
        -Dcollector.log.dir="$LOGDIR" \
        -classpath "$HERE/config:$HERE/lib/*" \
        io.softwareecg.collector.StartCollector "$CONFIG" "$LOGDIR" > /dev/null 2>> "$STDERR" &
    pid=$!
    echo "$pid" > "$PID_FILE"
    # a JVM that cannot start - wrong option, no memory - is gone within a moment
    sleep 2
    if ! kill -0 "$pid" 2> /dev/null; then
        rm -f "$PID_FILE"
        echo "The collector stopped right after its start. The last output of the JVM ($STDERR):" >&2
        tail -n 20 "$STDERR" >&2
        return 1
    fi
    echo "Started the collector (pid $pid) with $CONFIG."
}

stop() {
    local pid
    if ! pid="$(running_pid)"; then
        echo "The collector is not running."
        rm -f "$PID_FILE"
        return 0
    fi
    kill "$pid"
    for _ in $(seq 1 30); do
        if ! kill -0 "$pid" 2> /dev/null; then
            rm -f "$PID_FILE"
            echo "Stopped the collector."
            return 0
        fi
        sleep 1
    done
    echo "The collector (pid $pid) did not stop within 30 seconds." >&2
    return 1
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|force-reload)
        stop && start
        ;;
    status)
        if pid="$(running_pid)"; then
            echo "The collector is running (pid $pid)."
        else
            echo "The collector is not running."
            exit 3
        fi
        ;;
    version)
        version="$(ls "$HERE"/lib/collector-core-*.jar 2> /dev/null | head -1)"
        version="${version##*/collector-core-}"
        echo "Software-EKG collector ${version%.jar}"
        ;;
    *)
        echo "Usage: $(basename "$0") start | stop | restart | status | version"
        exit 1
        ;;
esac
