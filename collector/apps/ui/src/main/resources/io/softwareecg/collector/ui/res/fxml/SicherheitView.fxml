                                <String fx:value="labeled"/>
                                <String fx:value="settingsItem"/>
                                <String fx:value="bottomRightItem"/>
                            </styleClass>
                        </Button>
                        <Button fx:id="dreiButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
