<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="parent" prefHeight="240.0" prefWidth="320.0" xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.softwareecg.collector.ui.controller.SpeicherViewController">
    <children>
        <VBox maxWidth="1.7976931348623157E308" prefHeight="240.0">
            <children>
                <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="70.0"
                      styleClass="infobarBackground">
                    <children>
                        <Button fx:id="backButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" onAction="#backButtonPressed" prefHeight="69.0"
                                prefWidth="107.0" text="Back">
                            <effect>
                                <Blend mode="MULTIPLY"/>
                            </effect>
                            <styleClass>
                                <String fx:value="label"/>
                                <String fx:value="infobarBackButton"/>
                            </styleClass>
                        </Button>
                        <ComboBox id="infobarLabel" prefHeight="98.0" prefWidth="214.0" promptText="Drives"
                                  xmlns:fx="http://javafx.com/fxml">
                            <styleClass>
                                <String fx:value="combo-box-base"/>
                                <String fx:value="combo-box"/>
                                <String fx:value="label"/>
                            </styleClass>
                            <HBox.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                            </HBox.margin>
                        </ComboBox>
                    </children>
                </HBox>
                <HBox prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <PieChart fx:id="pieChart" prefHeight="240.0" prefWidth="320.0" title="Storage"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
