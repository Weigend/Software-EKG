<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:id="parent" prefHeight="240.0" prefWidth="320.0" xmlns="http://javafx.com/javafx/8"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="io.softwareecg.collector.ui.controller.EinstellungsdialogViewController">
    <children>
        <GridPane>
            <children>
                <HBox prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Button fx:id="backButton" contentDisplay="CENTER" maxHeight="1.7976931348623157E308"
                                maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                onAction="#zurueckButtonPressed" prefHeight="69.0" prefWidth="107.0" text="Back"
                                textAlignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <effect>
                                <Blend mode="MULTIPLY"/>
                            </effect>
                            <styleClass>
                                <String fx:value="labeled"/>
                                <String fx:value="infobarBackButton"/>
                            </styleClass>
                        </Button>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="69.0"
                               prefWidth="229.0" text="Settings">
                            <styleClass>
                                <String fx:value="label"/>
                                <String fx:value="infobarLabel"/>
                            </styleClass>
                        </Label>
                    </children>
                    <styleClass>
                        <String fx:value="heading"/>
                        <String fx:value="infobarBackground"/>
                    </styleClass>
                </HBox>
                <GridPane fx:id="vierButtonsinderMitte" GridPane.rowIndex="1">
                    <children>
                        <Button fx:id="changePasswordButton" cacheHint="SPEED" maxHeight="1.7976931348623157E308"
                                maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                onAction="#passwortButtonPressed" text="Change Password" GridPane.columnIndex="1"
                                GridPane.rowIndex="1">
                            <styleClass>
                                <String fx:value="button"/>
                                <String fx:value="bottomRightItem"/>
                            </styleClass>
                            <GridPane.margin>
                                <Insets/>
                            </GridPane.margin>
                        </Button>
                        <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" onAction="#styleaendernButtonPressed" prefHeight="51.0"
                                prefWidth="156.0" text="Change Style" GridPane.rowIndex="1"
                                xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
                            <styleClass>
                                <String fx:value="button"/>
                                <String fx:value="bottomLeftItem"/>
                            </styleClass>
                            <GridPane.margin>
                                <Insets/>
                            </GridPane.margin>
                        </Button>
                        <Button fx:id="importConfigButton" maxHeight="1.7976931348623157E308"
                                maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                onAction="#konfigurationImportButtonPressed" prefHeight="59.0" prefWidth="77.0"
                                text="Import Configuration" GridPane.columnIndex="1">
                            <styleClass>
                                <String fx:value="button"/>
                                <String fx:value="topRightItem"/>
                            </styleClass>
                            <GridPane.margin>
                                <Insets/>
                            </GridPane.margin>
                        </Button>
                        <Button fx:id="showSpaceButton" maxHeight="1.7976931348623157E308"
                                maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                onAction="#showSpaceButtonPressed" prefHeight="51.0" prefWidth="156.0"
                                text="Show Configuration">
                            <styleClass>
                                <String fx:value="button"/>
                                <String fx:value="topLeftItem"/>
                            </styleClass>
                            <GridPane.margin>
                                <Insets/>
                            </GridPane.margin>
                        </Button>
                    </children>
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0"
                                           prefWidth="148.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0"
                                           prefWidth="147.0" xmlns="http://javafx.com/javafx/8"
                                           xmlns:fx="http://javafx.com/fxml/1"/>
                    </columnConstraints>
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </padding>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" percentHeight="50.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="10.0" percentHeight="50.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                </GridPane>
            </children>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="-Infinity"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="15.0" vgrow="SOMETIMES"/>
                <RowConstraints maxHeight="183.0" minHeight="10.0" prefHeight="171.0" vgrow="SOMETIMES"/>
            </rowConstraints>
        </GridPane>
    </children>
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints maxHeight="1.7976931348623157E308" minHeight="10.0" prefHeight="230.0" vgrow="SOMETIMES"/>
    </rowConstraints>
</GridPane>
