<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="parent" maxHeight="720.0" maxWidth="1280.0" prefHeight="480.0" prefWidth="640.0"
            styleClass="background" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.softwareecg.collector.ui.controller.RuntimeViewController">
    <children>
        <GridPane id="UiGrid" fx:id="gridPane" cache="true" cacheHint="SPEED" AnchorPane.bottomAnchor="0.0"
                  AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
                  xmlns:fx="http://javafx.com/fxml">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label/>
                <Label id="ipLabel" fx:id="ipLabel" alignment="CENTER" prefHeight="247.0" prefWidth="1280.0" text="IP"
                       textFill="#f8f4f4" GridPane.rowIndex="1">
                    <font>
                        <Font size="24.0"/>
                    </font>
                    <graphic>
                        <Label text="Collector IP Adress: " textFill="#908d8d">
                            <font>
                                <Font size="10.0"/>
                            </font>
                        </Label>
                    </graphic>
                </Label>

                <Button id="stopButton" fx:id="stopButton" cancelButton="true" maxHeight="1.7976931348623157E308"
                        maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#stopEKG" text="Stop"
                        GridPane.rowIndex="2" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
                    <GridPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </GridPane.margin>
                </Button>
                <Button id="datenansichtButton" fx:id="datenansichtButton" maxHeight="1.7976931348623157E308"
                        maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#gotoChartView"
                        text="Data View" GridPane.rowIndex="3" xmlns="http://javafx.com/javafx/8"
                        xmlns:fx="http://javafx.com/fxml/1">
                    <GridPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </GridPane.margin>
                </Button>
            </children>
        </GridPane>
    </children>
</AnchorPane>
