<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="MainPane" fx:id="parent" maxHeight="240.0" maxWidth="320.0" minHeight="240.0" minWidth="320.0"
            prefHeight="240.0" prefWidth="320" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.softwareecg.collector.ui.controller.LoginViewController">
    <children>
        <GridPane id="UiGrid" layoutX="-21.0" layoutY="-7.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns:fx="http://javafx.com/fxml">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"
                                   xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Button fx:id="loeschenButton" mnemonicParsing="false" onAction="#loeschenButtonPressed"
                        prefHeight="87.0" prefWidth="123.0" text="Delete" GridPane.columnIndex="2"
                        GridPane.rowIndex="2"/>
                <Button fx:id="dreiButton" mnemonicParsing="false" onAction="#numberPressed" prefHeight="87.0"
                        prefWidth="123.0" text="3" GridPane.rowIndex="2" xmlns="http://javafx.com/javafx/8"
                        xmlns:fx="http://javafx.com/fxml/1"/>
                <Button fx:id="einsButton" mnemonicParsing="false" onAction="#numberPressed" prefHeight="87.0"
                        prefWidth="123.0" text="1" GridPane.rowIndex="1" xmlns="http://javafx.com/javafx/8"
                        xmlns:fx="http://javafx.com/fxml/1"/>
                <Button fx:id="vierButton" mnemonicParsing="false" onAction="#numberPressed" prefHeight="87.0"
                        prefWidth="123.0" text="4" GridPane.columnIndex="1" GridPane.rowIndex="2"
                        xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"/>
                <Button fx:id="zweiButton" mnemonicParsing="false" onAction="#numberPressed" prefHeight="87.0"
                        prefWidth="123.0" text="2" GridPane.columnIndex="1" GridPane.rowIndex="1"
                        xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"/>
                <Label id="passwordLabel" fx:id="passwortLabel" prefHeight="80.0" prefWidth="130.0" text="Password"
                       textFill="RED" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <styleClass>
                        <String fx:value="label"/>
                        <String fx:value="settingsPane"/>
                    </styleClass>
                </Label>
            </children>
        </GridPane>
    </children>
</AnchorPane>
