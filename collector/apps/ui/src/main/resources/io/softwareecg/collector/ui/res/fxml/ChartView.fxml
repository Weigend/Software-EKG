<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="MainPane" fx:id="parent" maxHeight="317.0" maxWidth="437.0" minHeight="240.0" minWidth="320.0"
            prefHeight="317.0" prefWidth="437.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.softwareecg.collector.ui.controller.ChartViewController">
    <children>
        <GridPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="240.0"
                  prefWidth="320.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns:fx="http://javafx.com/fxml">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="70.0" prefHeight="70.0" valignment="CENTER" vgrow="ALWAYS"/>
                <RowConstraints maxHeight="1.7976931348623157E308" minHeight="10.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <LineChart fx:id="lineChart" cache="true" maxHeight="1.7976931348623157E308"
                           maxWidth="1.7976931348623157E308" title="Live Data" GridPane.rowIndex="1">
                    <xAxis>
                        <CategoryAxis side="BOTTOM" styleClass="button"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis id="axis2" cache="true" cacheHint="SPEED" side="LEFT" tickLabelFill="BLACK">
                            <effect>
                                <Blend mode="OVERLAY"/>
                            </effect>
                        </NumberAxis>
                    </yAxis>
                </LineChart>
                <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="50.0"
                      styleClass="infobarBackground" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                    <children>
                        <Button fx:id="backButton" defaultButton="true" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" onAction="#backButtonPressed" prefHeight="70.0" text="Back">
                            <styleClass>
                                <String fx:value="button"/>
                                <String fx:value="infobarBackButton"/>
                            </styleClass>
                        </Button>
                        <ComboBox fx:id="combo" maxWidth="1.7976931348623157E308" prefHeight="70.0" prefWidth="375.0"
                                  promptText="Please select a metricDefinition" HBox.hgrow="ALWAYS">
                            <GridPane.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                            </GridPane.margin>
                        </ComboBox>
                    </children>
                </HBox>
            </children>
        </GridPane>
    </children>
</AnchorPane>
