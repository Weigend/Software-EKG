<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.softwareecg</groupId>
    <artifactId>software-ekg</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Software EKG</name>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <description>Single-repository build for the workbench and the headless collector.</description>

    <!-- global properties for the whole project  -->
    <properties>
        <revision>7.3.0</revision>
        <!-- what a build is made from, shown next to the version; a build server passes
             -Dbuild.revision=<commit> -->
        <build.revision>local</build.revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <solrVersion>9.10.1</solrVersion>
        <poiVersion>5.5.1</poiVersion>
        <wfxVersion>1.4.1</wfxVersion>
        <slf4jVersion>2.0.17</slf4jVersion>
        <jacksonVersion>2.21.8</jacksonVersion>
        <java.version>25</java.version>
        <javafx.version>25.0.5.1</javafx.version>
        <avaje.version>11.4</avaje.version>
        <!-- empty default; JaCoCo's prepare-agent overwrites this when metrics profile is active -->
        <argLine/>
    </properties>

    <!-- Real deployment and extension boundaries only. The former 83-project reactor
         represented implementation layers as artifacts; those layers now live as packages. -->
    <modules>
        <!-- The collector artifacts inherit their dependency management from this parent.
             Keep it in the reactor so install/deploy publishes a usable consumer model. -->
        <module>build/collector-parent</module>
        <module>collector/core</module>
        <module>collector/repositories/csv</module>
        <module>collector/repositories/json</module>
        <module>collector/repositories/rdb</module>
        <module>collector/repositories/solr</module>
        <module>collector/repositories/elasticsearch</module>
        <module>collector/sources/jmx</module>
        <module>collector/sources/jolokia</module>
        <module>collector/sources/log</module>
        <module>collector/sources/mock</module>
        <module>collector/sources/prometheus</module>
        <module>collector/sources/unix</module>
        <module>collector/sources/windows</module>
        <module>collector/apps/cli</module>
        <module>collector/apps/ui</module>
        <module>collector/apps/jolokia-agent</module>
        <module>workbench</module>
    </modules>


    <!-- profiles to build the native the EKG bundle with the correct native JavaFX libs -->
    <profiles>
        <profile>
            <id>linux</id>
            <activation>
                <os>
                    <name>linux</name>
                </os>
            </activation>
            <properties>
                <javafx.platform>linux</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>macosx</id>
            <activation>
                <os>
                    <name>mac os x</name>
                </os>
            </activation>
            <properties>
                <javafx.platform>mac</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <javafx.platform>win</javafx.platform>
            </properties>
        </profile>
        <!-- Software City metrics: activate with  mvn verify -Pmetrics  -->
        <profile>
            <id>metrics</id>
            <build>
                <plugins>

                    <!-- JaCoCo: Code Coverage -->
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jacoco-prepare</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>jacoco-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Checkstyle: Code Style -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-checkstyle-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>checkstyle</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>checkstyle</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <failOnViolation>false</failOnViolation>
                            <outputFileFormat>xml</outputFileFormat>
                        </configuration>
                    </plugin>

                    <!-- PMD: Code Quality -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-pmd-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>pmd-analysis</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>pmd</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <failOnViolation>false</failOnViolation>
                            <targetJdk>${java.version}</targetJdk>
                        </configuration>
                    </plugin>

                    <!-- SpotBugs: Bug Detection -->
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>spotbugs-analysis</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>spotbugs</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <failOnError>false</failOnError>
                            <xmlOutput>true</xmlOutput>
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>
    </profiles>


